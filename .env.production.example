# ==============================================================================
# Karsa Pantau — Production Environment Configuration (DigitalOcean Droplet)
# ==============================================================================

# 1. Domain & SSL Let's Encrypt
DOMAIN=app.karsapantau.id
SSL_EMAIL=admin@karsapantau.id

# 2. Database PostgreSQL 16 + pgvector
POSTGRES_DB=karsa_db
POSTGRES_USER=karsa_user
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_kuat_dan_acak

# 3. Cache Redis 7
REDIS_URL=redis://redis:6379

# 4. Auth Security (Generate dengan: openssl rand -hex 32)
JWT_SECRET=isi_dengan_random_secret_minimal_32_karakter_untuk_access_token
JWT_REFRESH_SECRET=isi_dengan_random_secret_minimal_32_karakter_untuk_refresh_token

# 5. Object Storage (MinIO lokal di Droplet atau DigitalOcean Spaces)
# Bila menggunakan MinIO lokal di Droplet:
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=karsa-pantau-receipts
OBJECT_STORAGE_KEY=karsa_minio_admin_user
OBJECT_STORAGE_SECRET=karsa_minio_admin_password_kuat
OBJECT_STORAGE_USE_SSL=false

# Bila menggunakan DigitalOcean Spaces (Sangat direkomendasikan untuk backup):
# OBJECT_STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com
# OBJECT_STORAGE_BUCKET=karsa-pantau-storage
# OBJECT_STORAGE_KEY=DO_SPACES_KEY_ANDA
# OBJECT_STORAGE_SECRET=DO_SPACES_SECRET_ANDA
# OBJECT_STORAGE_USE_SSL=true

# 6. AI Gateway (9Router)
NINE_ROUTER_API_KEY=nr-droplet-internal-cluster-key
ANTHROPIC_API_KEY=sk-ant-api-key-claude-anda
OPENAI_API_KEY=sk-proj-api-key-openai-embedding-anda

# 7. Frontend Client Config
NEXT_PUBLIC_API_BASE_URL=https://app.karsapantau.id/api/v1
